<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed launcher icon: the shadPS4 logo is the background layer so it fills the entire icon
     tile (edge to edge, masked to the launcher's shape) instead of being inset in the safe zone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_full" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
